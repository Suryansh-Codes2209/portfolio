# Copy to .env.local and fill in. Also set these in the Vercel project env vars.
# Every integration degrades gracefully: leave a group blank and that feature
# disables itself (likes hide, subscribe returns a friendly error).
# NEVER put real secrets in this file — it is committed to git.

# --- Email (Resend) — verify your sending domain in the Resend dashboard ---
RESEND_API_KEY=
RESEND_FROM="Suryansh <hello@suryansh.work>"
RESEND_REPLY_TO=hello@suryansh.work

# --- Likes (Upstash Redis TCP/TLS endpoint, rediss://…upstash.io:6379) ---
REDIS_URL=
LIKE_SALT=some-random-string

# --- Subscribers (Supabase Postgres connection string) ---
DATABASE_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://suryansh.work
CRON_SECRET=some-random-string
